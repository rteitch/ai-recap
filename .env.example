# Get this from the EdgeOne Makers console (Makers > your project > Models / AI Gateway).
AI_GATEWAY_API_KEY=

# Default EdgeOne Makers model gateway endpoint. Only change if you're using
# a different OpenAI-compatible provider.
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1

# Free built-in model with a token allowance for new accounts.
# Swap this for another supported model id if you bring your own provider key.
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash
